# Created automatically by `pnpm convex dev` after you link a Convex project.
NEXT_PUBLIC_CONVEX_URL=

# Use the exact same value in Vercel and in the Convex deployment environment.
ADMIN_ACCESS_TOKEN=

# Cloudinary API credentials. The API secret is server-only.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
